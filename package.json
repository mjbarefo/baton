{
  "name": "ccbaton",
  "version": "0.4.0",
  "description": "Local-first session baton for Claude Code, Codex CLI, and Gemini CLI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjbarefo/baton"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "baton": "dist/cli.js"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "postinstall": "node -e \"require('fs').existsSync('dist/cli.js') && require('child_process').execFileSync('node', ['dist/cli.js', 'install', '--postinstall'], {stdio:'inherit'})\" || true"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "statusline",
    "baton",
    "context",
    "handoff"
  ]
}
